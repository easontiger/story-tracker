{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Story Tracker",
  "version": "0.1.0",
  "identifier": "local.story-tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Story Tracker", "width": 1000, "height": 760, "minWidth": 680, "minHeight": 480 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false }
}
